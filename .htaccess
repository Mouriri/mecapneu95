# ==========================================================================
# MECA PNEU 95 - CONFIGURATION SERVEUR & SÉCURITÉ (.htaccess)
# ==========================================================================

# 1. Empêcher l'exploration des répertoires (Directory Browsing)
Options -Indexes -MultiViews

# 2. Redirection forcée vers HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. En-têtes de Sécurité HTTP (Security Headers)
<IfModule mod_headers.c>
    # Protection contre le reniflage de type MIME (MIME Sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # Protection contre le Clickjacking (interdire l'intégration en iframe externe)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Protection XSS legacy pour navigateurs anciens
    Header always set X-XSS-Protection "1; mode=block"

    # Politique de Referrer sécurisée
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS (Strict-Transport-Security) - Forcer le protocole HTTPS sur 1 an
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Restriction des APIs matérielles du navigateur (Permissions Policy)
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)"

    # Politique de Sécurité de Contenu (Content Security Policy)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src https://maps.google.com https://www.google.com https://www.google.com/maps/; connect-src 'self' https:; base-uri 'self'; form-action 'self' https://wa.me https://maps.google.com;"
</IfModule>

# 4. Blocage de l'accès aux fichiers sensibles et dossiers cachés (.git, .env, .jsonl, etc.)
<FilesMatch "(^\.|\.jsonl$|\.env$|\.bak$|\.config$|\.sql$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Compression Gzip / Deflate pour les performances
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Cache Navigateur pour optimiser le chargement
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
